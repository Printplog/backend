# ------------------------------------------------------------------------------
#  Sharptoolz Celery Worker – Dokploy
#  Runs background analytics tasks. Scale horizontally as needed.
# ------------------------------------------------------------------------------

# -- Stage 1: Build deps --
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_VIRTUALENVS_CREATE=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    pkg-config \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install poetry>=2.0.0

COPY pyproject.toml poetry.lock* ./
RUN poetry lock && poetry install --no-root && rm -rf $POETRY_CACHE_DIR


# -- Stage 2: Runtime --
FROM python:3.11-slim-bookworm AS runtime

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app" \
    PYTHONUNBUFFERED=1 \
    CELERY_CONCURRENCY=2 \
    CELERY_LOGLEVEL=info \
    CELERY_QUEUES=celery \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Runtime libs (mirrors web image so tasks importing cairo/PIL/etc. work)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libxml2-dev \
    libxslt1-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libasound2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
RUN mkdir -p "$PLAYWRIGHT_BROWSERS_PATH" \
    && playwright install --with-deps chromium \
    && chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH" \
    && rm -rf /var/lib/apt/lists/*
COPY . .

# Render attacker-influenced documents without root privileges. Object-storage
# deployments do not need local persistence; filesystem deployments must mount
# their shared media volume with uid/gid 10001 write access.
RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/media /app/temp_uploads \
    && chown -R appuser:appuser /app/media /app/temp_uploads
USER appuser

# Worker health = can it reach the broker and respond to ping?
# Node name MUST match the -n below (worker@%h) — pinging celery@ never replies.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD celery -A serverConfig inspect ping -d worker@$HOSTNAME || exit 1

CMD celery -A serverConfig worker \
    --loglevel="$CELERY_LOGLEVEL" \
    --concurrency="$CELERY_CONCURRENCY" \
    --queues="$CELERY_QUEUES" \
    --max-tasks-per-child=500 \
    -n "worker@%h"
